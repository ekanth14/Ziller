.coverage
htmlcov/
.tox/

# Large weights, checkpoints & models
*.safetensors
*.bin
*.pt
*.onnx
checkpoints/
data/models/
data/training/*.jsonl

# OS specific
.DS_Store
Thumbs.db
desktop.ini

# Logs & Temporary Workspaces
*.log
logs/
.system_generated/
