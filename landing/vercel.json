{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/collaborations", "destination": "/api/collaborations" },
    { "source": "/collaborate/submissions", "destination": "/api/collaborations" },
    { "source": "/api/collaborate/list", "destination": "/api/collaborate" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api/|assets/|favicon.ico).*)", "destination": "/index.html" }
  ]
}
