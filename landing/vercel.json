{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": ".*\\.vercel\\.app"
        }
      ],
      "destination": "https://zillers.zienorganisation.online/collaborate",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/collaborations",
      "destination": "/api/collaborations"
    },
    {
      "source": "/collaborate/submissions",
      "destination": "/api/collaborations"
    },
    {
      "source": "/api/collaborate/list",
      "destination": "/api/collaborate"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}