# =============================================================================
# ZILLERS QUANTITATIVE TERMINAL - ENVIRONMENT CONFIGURATION
# =============================================================================

# Server Network Configuration
HOST=127.0.0.1
PORT=8900
TRUST_PROXY=false

# Authentication & Admin Bootstrap
# MANDATORY: The terminal will fail to start if ADMIN_INITIAL_PASSWORD is unset.
# The bootstrapped admin account must change this password on first login.
ADMIN_INITIAL_PASSWORD=SetAStrongPasswordHere123!

# Account Registration Policy: 'open' or 'invite'
SIGNUP_MODE=open
INVITE_CODE=ZILLERS-INVITE-2026

# Session & Security Settings
SESSION_MAX_AGE_SECONDS=43200
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
LOGIN_LOCKOUT_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION_SECONDS=900

# Market Data Aggregator & Freshness Thresholds
DEVIATION_THRESHOLD_PCT=1.0
TICKER_STALE_SECONDS=5.0
METADATA_STALE_SECONDS=120.0
FX_STALE_SECONDS=21600

# Laya AI Copilot Engine
# Pinned model: gemma4:12b (Strict grounding required; no synthetic fallbacks)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:12b

# Data & Persistence Directory
DATA_DIR=data
