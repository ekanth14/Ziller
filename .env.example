# =============================================================================
# ZILLERS QUANTITATIVE CRYPTO TERMINAL - CONFIGURATION MATRIX
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Server & Networking
# -----------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8900
# Set to 'true' only if behind a trusted reverse proxy (Nginx, Traefik, Cloudflare).
# When true, extracts client IP from X-Forwarded-For; otherwise strictly uses socket IP.
TRUST_PROXY=false

# -----------------------------------------------------------------------------
# 2. Authentication & Administrative Bootstrap (MANDATORY)
# -----------------------------------------------------------------------------
# System will fail startup immediately if ADMIN_INITIAL_PASSWORD is unset.
# No default fallback is permitted. Admin must change this password on first login.
ADMIN_INITIAL_PASSWORD=SetAStrongUniquePasswordHere!

# User Registration Policy: 'open' or 'invite'
SIGNUP_MODE=open
INVITE_CODE=ZILLERS-INVITE-2026

# Session TTL and Hardening (scrypt, sliding activity expiry)
SESSION_MAX_AGE_SECONDS=43200
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
LOGIN_LOCKOUT_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION_SECONDS=900

# -----------------------------------------------------------------------------
# 3. Market Data Aggregator & Freshness Thresholds
# -----------------------------------------------------------------------------
# Cross-source price verification threshold (Binance, Coinbase, Kraken)
DEVIATION_THRESHOLD_PCT=1.0
TICKER_STALE_SECONDS=5.0
METADATA_STALE_SECONDS=120.0
FX_STALE_SECONDS=21600

# -----------------------------------------------------------------------------
# 4. Multi-Gate Execution Governor & Live Safety Controls
# -----------------------------------------------------------------------------
# Live trading multi-gatekeeper. Default MUST BE 'false'.
# Unlocking LIVE requires all 5 gates:
# 1. LIVE_TRADING=true
# 2. Exchange API credentials configured below
# 3. >= 50 paper trades with net positive PnL
# 4. Operator password re-authentication within 5 minutes
# 5. Exact confirmation prompt: "ENABLE LIVE TRADING"
LIVE_TRADING=false

# Exchange API Credentials (Spot Only - Ensure withdrawal permissions are DISABLED)
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_API_PASSPHRASE=

# Risk Management Limits
MAX_POSITION_PCT=0.05
MAX_GROSS_LEVERAGE=1.0
MAX_DAILY_LOSS_PCT=0.03
MAX_OPEN_ORDERS=10

# -----------------------------------------------------------------------------
# 5. Laya AI Copilot Engine (Local Gemma 4 Explainer Desk)
# -----------------------------------------------------------------------------
# Pinned model: gemma4:12b (Strict grounding on stored data; explain desk only)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:12b

# -----------------------------------------------------------------------------
# 6. Persistence & Storage
# -----------------------------------------------------------------------------
DATA_DIR=data
